# TEMPLATE ONLY: install manually after DNS, permissions and TLS review.
server {
    listen 80;
    server_name preview.ekebitola.org;
    root /srv/eke-staging/current;
    index index.html;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Reviewed public reads only. Admin/auth routing requires separate approval.
    # Keep the API path intact and let Spring enforce news image visibility.
    location ~ "^/api/(projects/(?:public|recent|get/[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}|slug/[a-z0-9-]+)?|news/(?:homepage|public(?:/[0-9]+)?|slug/[a-z0-9-]+)|opportunities/(?:public|slug/[a-z0-9-]+)|training/(?:sessions|slug/[a-z0-9-]+)|uploads/(?:news|images|pdf)/[^/;]+)$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }
    location = /api { return 404; }
    location /api/ { return 404; }
    location = /release-id.txt {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ =404;
    }
    error_page 404 /404.html;
    location = /404.html { internal; }
    location ^~ /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }
    # Add staging-only TLS and optional access control before public exposure.
}
