# TEMPLATE: replace ENVIRONMENT with staging (port 18081) or production (18082).
# Install as /etc/systemd/system/eke-ENVIRONMENT-backend.service after review.
[Unit]
Description=EKE ENVIRONMENT backend
After=network.target
[Service]
User=eke-ENVIRONMENT
Group=eke-ENVIRONMENT
WorkingDirectory=/srv/eke-ENVIRONMENT-backend
EnvironmentFile=/etc/eke-ENVIRONMENT/backend.env
ExecStart=/usr/bin/java -jar /srv/eke-ENVIRONMENT-backend/current/app.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/eke-ENVIRONMENT-backend/data /srv/eke-ENVIRONMENT-backend/uploads
[Install]
WantedBy=multi-user.target
