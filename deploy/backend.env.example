# TEMPLATE ONLY. Never commit real credentials. Separate file/account/database per environment.
# staging example; production must use production paths and port 18082.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
SPRING_DATASOURCE_URL=jdbc:h2:file:/srv/eke-staging-backend/data/mydb;IFEXISTS=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_ENVIRONMENT_SPECIFIC_SECRET
SPRING_H2_CONSOLE_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Required before activating the Phase 1 backend. Supply a private, environment-specific
# Base64 key containing at least 32 random bytes. Never reuse the old checked-in key.
APP_JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_BASE64_KEY
APP_AUTH_COOKIE_SECURE=true
# Optional first administrator for a database without an ADMIN. Remove after provisioning.
# APP_BOOTSTRAP_ADMIN_USERNAME=
# APP_BOOTSTRAP_ADMIN_PASSWORD=
