# TEMPLATE ONLY. Never commit real credentials. Separate file/account/database per environment.
# Staging paths and port; production requires separate approval and configuration.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
SPRING_DATASOURCE_URL=jdbc:h2:file:/srv/eke-staging-backend/data/mydb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_ENVIRONMENT_SPECIFIC_SECRET
SPRING_H2_CONSOLE_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_MAIL_HOST=127.0.0.1
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=staging
MAIL_PASSWORD=REPLACE_WITH_STAGING_MAIL_SINK_PASSWORD
# Generate a unique Base64-encoded key of at least 32 cryptographically random bytes.
# Replacing the old hardcoded key invalidates all previously issued JWTs.
APP_JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_KEY
APP_AUTH_COOKIE_SECURE=true
# Leave blank for same-origin /api; never use a wildcard with credentials.
APP_ALLOWED_ORIGINS=
# Set temporarily only for an empty administrator store; remove after provisioning.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
